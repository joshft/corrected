<?xml version="1.0" encoding="utf-8"?>
<!-- INV-016 / BND-002 / TB-004: gate-local NuGet configuration. <clear/> drops
     every inherited machine/user source so restore is single-source-isolated
     (else NuGet merges upward to machine/user sources — the TB-004 hole).
     nuget.org is the sole source; package source mapping pins every package to
     it. Mirrors spikes/dafny-compat/NuGet.Config. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
