<Project>
  <!-- INV-016 sealing file: terminates MSBuild's upward Directory.Build.props
       inheritance at the gate root so no props above gate/ leaks into
       resolution. Mirrors spikes/dafny-compat/Directory.Build.props discipline. -->
  <PropertyGroup>
    <!-- INV-015: committed lock file per project; locked-mode restore once the
         lock exists. First restore (no lock yet) generates it; thereafter locked. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="Exists('$(MSBuildProjectDirectory)/packages.lock.json')">true</RestoreLockedMode>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- NuGet downgrade warnings are errors (supply-chain hygiene, INV-015). CS8509 (a switch
         expression does not handle all values) is an error too (MA-I): a new enum member added to a
         no-default fail-closed switch (e.g. PostEntryHealth) is then a COMPILE stop, not a silent
         warning that ships and throws at runtime. -->
    <WarningsAsErrors>$(WarningsAsErrors);NU1605;CS8509</WarningsAsErrors>
  </PropertyGroup>
</Project>
